{
  "name": "cirujar",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "front",
    "back"
  ],
  "scripts": {
    "app": "concurrently -n back,front -c cyan,magenta \"npm run dev:back\" \"npm run start:front\"",
    "dev:back": "npm run dev -w back",
    "start:front": "npm start -w front"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "expo-location": "~19.0.8",
    "react-native-maps": "1.20.1"
  }
}
