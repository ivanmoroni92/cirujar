# Copy to `back/.env` and fill values (do not commit `.env`).

# Toggle local vs cloud DB and API host in ../_config.js (USE_LOCAL_DB, IP_LOCAL, USE_EXPO_GO).
MONGO_URI_LOCAL=mongodb://localhost:27017/cirujar_db
MONGO_URI_CLOUD=mongodb+srv://USER:PASS@cluster.example.mongodb.net/cirujar
PORT=3000

# Required in production (min 16 characters). In development a weak default is used if unset.
JWT_SECRET=change-this-to-a-long-random-string

# Optional JWT lifetime (default 7d). Examples: 24h, 7d, 30d
# JWT_EXPIRES_IN=7d
